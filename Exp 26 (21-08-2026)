import pandas as pd
import matplotlib.pyplot as plt
from scipy import stats

# Read dataset
df = pd.read_csv("treatment_data.csv")

# Separate groups
control = df[df["Group"] == "Control"]["Improvement"]
treatment = df[df["Group"] == "Treatment"]["Improvement"]

# Calculate means
control_mean = control.mean()
treatment_mean = treatment.mean()

# Perform independent sample t-test
t_statistic, p_value = stats.ttest_ind(
    treatment,
    control
)

# Display results
print("Hypothesis Testing - Medical Treatment")
print("---------------------------------------")

print("Control Group Mean:",
      round(control_mean, 2))

print("Treatment Group Mean:",
      round(treatment_mean, 2))

print("T-Statistic:",
      round(t_statistic, 4))

print("P-Value:",
      round(p_value, 6))

# Hypothesis testing
alpha = 0.05

if p_value < alpha:
    print("\nDecision: Reject the Null Hypothesis")
    print("The treatment has a statistically significant effect.")
else:
    print("\nDecision: Fail to Reject the Null Hypothesis")
    print("The treatment does not have a statistically significant effect.")

# Visualization
groups = ["Control", "Treatment"]
means = [control_mean, treatment_mean]

plt.figure(figsize=(7, 5))
plt.bar(groups, means)

plt.title("Treatment Effectiveness")
plt.xlabel("Group")
plt.ylabel("Mean Improvement")

plt.text(
    0.5,
    max(means) * 0.9,
    "p-value = " + format(p_value, ".4f"),
    ha="center"
)

plt.show()
