import pandas as pd
import matplotlib.pyplot as plt

from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans

# Read dataset
df = pd.read_csv("store_customers.csv")

print("Store Customer Dataset:")
print(df)

# Features
X = df[
    ["Total_Spent", "Visit_Frequency"]
]

# Standardization
scaler = StandardScaler()

X_scaled = scaler.fit_transform(X)

# K-Means model
model = KMeans(
    n_clusters=3,
    random_state=42,
    n_init=10
)

# Cluster assignment
df["Cluster"] = model.fit_predict(X_scaled)

# Display results
print("\nCustomer Segments:")
print(
    df[
        ["Customer_ID", "Total_Spent",
         "Visit_Frequency", "Cluster"]
    ]
)

# Cluster summary
print("\nCluster Summary:")

print(
    df.groupby("Cluster")[
        ["Total_Spent", "Visit_Frequency"]
    ].mean()
)

# Visualization
plt.figure(figsize=(8, 6))

for cluster in sorted(df["Cluster"].unique()):

    cluster_data = df[
        df["Cluster"] == cluster
    ]

    plt.scatter(
        cluster_data["Total_Spent"],
        cluster_data["Visit_Frequency"],
        label="Cluster " + str(cluster)
    )

plt.title("Customer Segmentation Based on Spending")
plt.xlabel("Total Amount Spent")
plt.ylabel("Visit Frequency")
plt.legend()

plt.show()
