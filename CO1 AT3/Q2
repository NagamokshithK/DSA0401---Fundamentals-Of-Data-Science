import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
# Load the Healthcare Analysis dataset
file_path_healthcare = '/content/Healthcare_Analysis.xlsx'
df_healthcare = pd.read_excel(file_path_healthcare)

# Display the first 5 rows of the DataFrame
print('First 5 rows of the Healthcare Analysis dataset:')
display(df_healthcare.head())
# Display basic information about the healthcare dataset
print('\nInformation about the Healthcare Analysis dataset:')
df_healthcare.info()
# Display descriptive statistics for the healthcare dataset
print('\nDescriptive statistics of the Healthcare Analysis dataset:')
display(df_healthcare.describe())
# Check for missing values in the healthcare dataset
print('\nMissing values in each column of the Healthcare Analysis dataset:')
display(df_healthcare.isnull().sum())
numerical_features_healthcare = ['Age', 'Sugar_Level', 'BP', 'BMI']

plt.figure(figsize=(15, 10))
for i, feature in enumerate(numerical_features_healthcare):
    plt.subplot(2, 2, i + 1)
    sns.histplot(df_healthcare[feature], kde=True)
    plt.title(f'Distribution of {feature}')
    plt.xlabel(feature)
    plt.ylabel('Frequency')
plt.tight_layout()
plt.show()
plt.figure(figsize=(18, 6))

# Bar plot for average Age by Disease Status
plt.subplot(1, 4, 1)
sns.barplot(x='Disease_Status', y='Age', data=df_healthcare, palette='viridis')
plt.title('Average Age by Disease Status')
plt.xlabel('Disease Status')
plt.ylabel('Average Age')

# Bar plot for average Blood Sugar by Disease Status
plt.subplot(1, 4, 2)
sns.barplot(x='Disease_Status', y='Sugar_Level', data=df_healthcare, palette='plasma')
plt.title('Average Blood Sugar by Disease Status')
plt.xlabel('Disease Status')
plt.ylabel('Average Blood Sugar')

# Bar plot for average Blood Pressure by Disease Status
plt.subplot(1, 4, 3)
sns.barplot(x='Disease_Status', y='BP', data=df_healthcare, palette='magma')
plt.title('Average Blood Pressure by Disease Status')
plt.xlabel('Disease Status')
plt.ylabel('Average Blood Pressure')

# Bar plot for average BMI by Disease Status
plt.subplot(1, 4, 4)
sns.barplot(x='Disease_Status', y='BMI', data=df_healthcare, palette='cividis')
plt.title('Average BMI by Disease Status')
plt.xlabel('Disease Status')
plt.ylabel('Average BMI')

plt.tight_layout()
plt.show()
