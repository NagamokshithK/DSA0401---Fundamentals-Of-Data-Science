import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
# Load the Banking Loan Approval dataset
file_path_loan = '/content/Banking_Loan_Approval.xlsx'
df_loan = pd.read_excel(file_path_loan)

# Display the first 5 rows of the DataFrame
print('First 5 rows of the Banking Loan Approval dataset:')
display(df_loan.head())
# Display basic information about the loan dataset
print('\nInformation about the Banking Loan Approval dataset:')
df_loan.info()
# Display descriptive statistics for the loan dataset
print('\nDescriptive statistics of the Banking Loan Approval dataset:')
display(df_loan.describe())
# Check for missing values in the loan dataset
print('\nMissing values in each column of the Banking Loan Approval dataset:')
display(df_loan.isnull().sum())
numerical_features_loan = ['Income', 'Credit_Score', 'Loan_Amount']

plt.figure(figsize=(15, 5))
for i, feature in enumerate(numerical_features_loan):
    plt.subplot(1, 3, i + 1)
    sns.histplot(df_loan[feature], kde=True)
    plt.title(f'Distribution of {feature}')
    plt.xlabel(feature)
    plt.ylabel('Frequency')
plt.tight_layout()
plt.show()
plt.figure(figsize=(18, 6))

# Bar plot for average Income by Approval Status
plt.subplot(1, 3, 1)
sns.barplot(x='Loan_Status', y='Income', data=df_loan, palette='viridis')
plt.title('Average Income by Approval Status')
plt.xlabel('Approval Status')
plt.ylabel('Average Income')

# Bar plot for average Credit Score by Approval Status
plt.subplot(1, 3, 2)
sns.barplot(x='Loan_Status', y='Credit_Score', data=df_loan, palette='plasma')
plt.title('Average Credit Score by Approval Status')
plt.xlabel('Approval Status')
plt.ylabel('Average Credit Score')

# Bar plot for average Loan Amount by Approval Status
plt.subplot(1, 3, 3)
sns.barplot(x='Loan_Status', y='Loan_Amount', data=df_loan, palette='magma')
plt.title('Average Loan Amount by Approval Status')
plt.xlabel('Approval Status')
plt.ylabel('Average Loan Amount')

plt.tight_layout()
plt.show()
plt.figure(figsize=(8, 5))
sns.countplot(x='Employment_Type', hue='Loan_Status', data=df_loan, palette='crest')
plt.title('Loan Approval Status by Employment Type')
plt.xlabel('Employment Type')
plt.ylabel('Count')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.show()
