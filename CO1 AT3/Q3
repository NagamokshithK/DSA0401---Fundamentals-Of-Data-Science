import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
# Load the Retail Sales dataset
file_path_retail = '/content/Retail_Sales.xlsx'
df_retail = pd.read_excel(file_path_retail)

# Display the first 5 rows of the DataFrame
print('First 5 rows of the Retail Sales dataset:')
display(df_retail.head())
# Display basic information about the retail dataset
print('\nInformation about the Retail Sales dataset:')
df_retail.info()
# Display descriptive statistics for the retail dataset
print('\nDescriptive statistics of the Retail Sales dataset:')
display(df_retail.describe())
# Check for missing values in the retail dataset
print('\nMissing values in each column of the Retail Sales dataset:')
display(df_retail.isnull().sum())
numerical_features_retail = ['Price', 'Quantity_Sold', 'Discount', 'Revenue']

plt.figure(figsize=(15, 10))
for i, feature in enumerate(numerical_features_retail):
    plt.subplot(2, 2, i + 1)
    sns.histplot(df_retail[feature], kde=True)
    plt.title(f'Distribution of {feature}')
    plt.xlabel(feature)
    plt.ylabel('Frequency')
plt.tight_layout()
plt.show()
plt.figure(figsize=(18, 6))

# Bar plot for Total Revenue by Category
plt.subplot(1, 2, 1)
sns.barplot(x='Category', y='Revenue', data=df_retail.groupby('Category')['Revenue'].sum().reset_index(), palette='viridis')
plt.title('Total Revenue by Product Category')
plt.xlabel('Product Category')
plt.ylabel('Total Revenue')
plt.xticks(rotation=45, ha='right')

# Bar plot for Total Quantity Sold by Category
plt.subplot(1, 2, 2)
sns.barplot(x='Category', y='Quantity_Sold', data=df_retail.groupby('Category')['Quantity_Sold'].sum().reset_index(), palette='plasma')
plt.title('Total Quantity Sold by Product Category')
plt.xlabel('Product Category')
plt.ylabel('Total Quantity Sold')
plt.xticks(rotation=45, ha='right')

plt.tight_layout()
plt.show()
