#Confidence Interval for Blood Pressure Reduction
import numpy as np
from scipy import stats
drug = np.array([
12,15,10,18,14,16,13,15,17,14,
16,18,19,11,15,14,17,16,13,18,
15,14,16,17,12
])
placebo = np.array([
5,7,6,8,4,5,6,7,5,4,
6,5,7,8,6,5,7,6,4,5,
6,7,5,6,4
])
drug_mean = np.mean(drug)
drug_sem = stats.sem(drug)
drug_ci = stats.t.interval(
    confidence=0.95,
    df=len(drug)-1,
    loc=drug_mean,
    scale=drug_sem
)
placebo_mean = np.mean(placebo)
placebo_sem = stats.sem(placebo)
placebo_ci = stats.t.interval(
    confidence=0.95,
    df=len(placebo)-1,
    loc=placebo_mean,
    scale=placebo_sem
)
print("Drug Group")
print("Mean Reduction =", round(drug_mean,2))
print("95% Confidence Interval =", drug_ci)
print("\nPlacebo Group")
print("Mean Reduction =", round(placebo_mean,2))
print("95% Confidence Interval =", placebo_ci)
