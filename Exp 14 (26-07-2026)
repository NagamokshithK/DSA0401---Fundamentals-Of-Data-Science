import numpy as np
import matplotlib.pyplot as plt
import pandas as pd
x = pd.read_csv("Exam.csv")
study_time = x["Study Time"]
exam_score = x["Exam Score"]
correlation = np.corrcoef(study_time, exam_score)
print("Correlation Matrix")
print(correlation)
plt.scatter(study_time, exam_score)
plt.title("Study Time vs Exam Score")
plt.xlabel("Study Time (Hours)")
plt.ylabel("Exam Score")
plt.grid(True)
plt.show()
